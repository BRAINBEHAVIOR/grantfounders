# GrantFounders Environment Variables Template
# Copy this file to .env.local for local development
# Add these variables to Vercel for production deployment
# DO NOT commit actual values to git

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================
# Get these from your Supabase project: Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# =============================================================================
# SECURITY (Required)
# =============================================================================
# JWT_SECRET: Secret key for JWT token signing (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-min-32-chars

# GF_SECRET_KEY: Master key for owner-level authentication
# Keep this extremely secure, it bypasses all rate limits and billing
GF_SECRET_KEY=gf-777ace-your-secret-key

# =============================================================================
# APPLICATION CONFIGURATION (Required)
# =============================================================================
# Application version and environment
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_ENVIRONMENT=development

# =============================================================================
# STRIPE CONFIGURATION (Optional)
# =============================================================================
# Set to "true" to enable Stripe billing features
# If false, the app will work without Stripe integration
ENABLE_STRIPE=false

# Only required if ENABLE_STRIPE=true
# Get these from your Stripe dashboard: https://dashboard.stripe.com
# STRIPE_SECRET_KEY=sk_test_... # Use sk_live_... for production
# STRIPE_WEBHOOK_SECRET=whsec_... # From Stripe webhook configuration
# STRIPE_PRO_PRICE_ID=price_... # Your Pro tier price ID
# STRIPE_ENTERPRISE_PRICE_ID=price_... # Your Enterprise tier price ID

# =============================================================================
# NOTES
# =============================================================================
# 1. For local development, copy this file to .env.local
# 2. For Vercel deployment, add these in Project Settings → Environment Variables
# 3. Set ENABLE_STRIPE=false if you don't have Stripe configured yet
# 4. Never commit actual credentials to git
# 5. Use different values for development and production
# 6. Rotate secrets regularly for security
